
# MISP reverse proxy - HTTP
server {
    listen 80;
    server_name misp.lab.local;

    return 301 https://$host$request_uri;
}

# MISP reverse proxy - HTTPS
server {
    listen 443 ssl;
    server_name misp.lab.local;

    ssl_certificate /etc/nginx/certs/misp.crt;
    ssl_certificate_key /etc/nginx/certs/misp.key;

    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100M;

    location / {
        proxy_pass https://192.168.1.114;

        proxy_http_version 1.1;

        # Forward original client information
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;

        # Backend HTTPS settings
        proxy_ssl_server_name on;
        proxy_ssl_name 192.168.1.114;

        # TEMPORARY: backend certificate is expired and self-signed.
        proxy_ssl_verify off;

        # Rewrite backend redirects to the WAF HTTPS hostname
        proxy_redirect https://192.168.1.114/ https://misp.lab.local/;
        proxy_redirect http://192.168.1.114/ https://misp.lab.local/;

        proxy_read_timeout 300s;
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
    }
}
