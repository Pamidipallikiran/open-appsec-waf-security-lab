# MISP IP-based HTTPS frontend: https://192.168.1.116/
# WAF frontend: 192.168.1.116
# SOAR backend: 192.168.1.121:443

server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate /etc/nginx/certs/misp.crt;
    ssl_certificate_key /etc/nginx/certs/misp.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100M;

    location / {
        proxy_pass https://192.168.1.121:443;

        proxy_http_version 1.1;

        # Forward original client information
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;

        # Backend HTTPS settings
        proxy_ssl_server_name on;
        proxy_ssl_name 192.168.1.121;

        # Lab-only: backend uses a self-signed/expired certificate.
        # Configure a trusted CA and enable verification for production.
        proxy_ssl_verify off;

        # Rewrite backend redirects to the IP-based frontend.
        proxy_redirect https://192.168.1.121/ https://192.168.1.116/;
        proxy_redirect http://192.168.1.121/ https://192.168.1.116/;

        proxy_read_timeout 300s;
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
    }
}
