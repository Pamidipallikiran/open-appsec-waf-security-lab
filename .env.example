# open-appsec image configuration
APPSEC_VERSION=latest

# Agent registration - replace with your own values
APPSEC_USER_EMAIL=your-email@example.com
APPSEC_AGENT_TOKEN=YOUR_AGENT_TOKEN

# Agent configuration
APPSEC_AUTO_POLICY_LOAD=true
APPSEC_HTTPS_PROXY=

# Host directory mappings
APPSEC_CONFIG=./appsec-config
APPSEC_DATA=./appsec-data
APPSEC_LOGS=./appsec-logs
APPSEC_LOCALCONFIG=./appsec-localconfig
NGINX_CONFIG=./configurations/nginx

# Frontend address on the macvlan network (must be free on your LAN)
NGINX_IPV4_ADDRESS=192.168.1.116

# Optional services - configure only if required
APPSEC_SMART_SYNC_STORAGE=./appsec-smart-sync
APPSEC_POSTGRES_STORAGE=./appsec-postgres
APPSEC_POSTGRES_VERSION=16
APPSEC_DB_USER=YOUR_DB_USER
APPSEC_DB_PASSWORD=YOUR_DB_PASSWORD
